# Public DSV production API. Override only for an explicitly approved local environment.
EXPO_PUBLIC_DSV_API_BASE_URL=https://clever-route-api.cleversystem.ai

# Local builds opt in to PR488 APIs. Formal production builds enable this in eas.json.
# Server deployment and release checks remain separate; this does not enable GPS sending.
EXPO_PUBLIC_DSV_OPERATIONAL_ENABLED=false
