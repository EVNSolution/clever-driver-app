{
  "cli": {
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DSV_API_BASE_URL": "https://clever-route-api.cleversystem.ai"
      },
      "android": {
        "prebuildCommand": "prebuild --no-install --template expo-template-bare-minimum@56.0.37",
        "buildType": "apk"
      }
    },
    "production": {
      "credentialsSource": "remote",
      "distribution": "store",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_DSV_OPERATIONAL_ENABLED": "true",
        "EXPO_PUBLIC_DSV_API_BASE_URL": "https://clever-route-api.cleversystem.ai"
      },
      "autoIncrement": true,
      "android": {
        "prebuildCommand": "prebuild --no-install --template expo-template-bare-minimum@56.0.37",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6806955523"
      }
    }
  }
}
